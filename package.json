{
  "name": "ha-house-control",
  "private": true,
  "version": "0.2.0",
  "description": "Interactive procedural 3D smart-home floor plan card for Home Assistant dashboards",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:demo && npm run build:card",
    "build:demo": "vite build",
    "build:card": "vite build --config vite.card.config.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-render.ts && tsx scripts/verify-bridge.ts"
  },
  "dependencies": {
    "@lit/task": "^1.0.0",
    "lit": "^3.0.0",
    "lucide": "^0.460.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
